DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# AUTH_URL — public site URL for auth callbacks (auto-detected in most cases)
# Set explicitly in production if admin redirects to localhost
# Example: AUTH_URL="https://your-domain.com"

# Seed admin (used by prisma db seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Vercel Blob (upload ảnh trong admin)
BLOB_READ_WRITE_TOKEN=""

# Google Analytics 4 (optional) — ví dụ: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
